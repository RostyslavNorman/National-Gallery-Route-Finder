               </children>
            </StackPane>
         </children>
      </AnchorPane>
      <AnchorPane VBox.vgrow="NEVER">
         <children>
            <Slider fx:id="slider" minorTickCount="1" prefHeight="14.0" prefWidth="787.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
